{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "每日备忘桌面版",
  "version": "0.1.4",
  "identifier": "com.memoryeveryday.desktopwidget",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "每日备忘桌面版",
        "url": "https://memoryeveryday.pages.dev/desktop-widget.html?desktop-shell=1&desktop-version=0.1.4",
        "width": 840,
        "height": 560,
        "minWidth": 310,
        "minHeight": 215,
        "center": true,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "把每日备忘日历留在桌面",
    "longDescription": "登录每日备忘账号，在桌面查看月历和每日安排，并通过拖拽调整日期和时间。",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
